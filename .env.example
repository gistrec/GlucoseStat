# One file, every role (see Roles in the README); each block is tagged with
# who reads it. A renderer needs only MYSQL_*: trimming the file for a
# renderer host keeps the LibreLinkUp account off that machine — the only
# reason to bother.

# LibreLinkUp account (the one the Libre 3 app shares the sensor with)  [libre]
EMAIL=you@example.com
PASSWORD=

# MySQL — each process creates the tables it is missing on start  [all]
MYSQL_USER=libre
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=libre
# Only for managed databases that require TLS (e.g. Yandex Cloud):
# MYSQL_SSL_CA=~/.mysql/root.crt

# Pushover — alerts on a low reading.  [publisher]
# Leave unset and the publisher runs as before, publishing and alerting
# about nothing.
# PUSHOVER_TOKEN=  # application token, from pushover.net/apps/build
# PUSHOVER_USER=   # user key, from the pushover.net front page

# Nightscout API v1 — приём показаний от приложения сенсора.  [nightscout]
# Секреты загрузчиков лежат в базе (только дайджест), здесь их нет: выдаёт
# и перевыпускает их `./venv/bin/python nightscout.py issue|rotate`.
# NIGHTSCOUT_HOST=127.0.0.1
# NIGHTSCOUT_PORT=8098
# Адрес, который печатает CLI, — его вводят в приложении.
# NIGHTSCOUT_PUBLIC_URL=https://glucose.gistrec.cloud

# Optional
FETCH_INTERVAL_MINUTES=5
# The timezone the collector slices days in (daily month view, usual-day
# profile). Like PUBLISH_PATH below, it resolves at import time — before this
# file is read — so it belongs in the environment (e.g. the env block of
# ecosystem.config.js), not here. Change it only together with HOME_TIMEZONE
# in web/js/format.js: nights, the usual-day profile and the month view are
# sliced in this zone, and on a mismatch the page warns in the console.
# DISPLAY_TZ=Europe/Belgrade
# LibreLinkUp region. Login follows a regional redirect and keeps the corrected
# region with the session, so this rarely needs setting.
# LLU_REGION=de

# PUBLISH_PATH belongs in the environment, not here: it resolves as publish.py
# loads, before this file is read, so a line here would reach nothing at all —
# the manual rebuild included. See the Running section of the README.
