# LibreLinkUp account (the one the Libre 3 app shares the sensor with)
EMAIL=you@example.com
PASSWORD=

# MySQL — the collector creates its table on first start
MYSQL_USER=libre
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=libre
# Only for managed databases that require TLS (e.g. Yandex Cloud):
# MYSQL_SSL_CA=~/.mysql/root.crt

# Pushover — alerts on a low reading. Leave unset and the collector runs as
# before, storing readings and alerting about nothing.
# PUSHOVER_TOKEN=  # application token, from pushover.net/apps/build
# PUSHOVER_USER=   # user key, from the pushover.net front page

# Optional
FETCH_INTERVAL_MINUTES=5
# The timezone the collector slices days in (daily month view, usual-day
# profile). Like PUBLISH_PATH below, it resolves at import time — before this
# file is read — so it belongs in the environment (e.g. the env block of
# ecosystem.config.js), not here. Change it only together with TIMEZONE in
# web/app.js: the page labels time with its own constant and refuses to draw
# a profile sliced in a different zone.
# DISPLAY_TZ=Europe/Belgrade
# LibreLinkUp region. Login follows a regional redirect and keeps the corrected
# region with the session, so this rarely needs setting.
# LLU_REGION=de

# PUBLISH_PATH belongs in the environment, not here: it resolves as publish.py
# loads, before this file is read, so a line here would reach nothing at all —
# the manual rebuild included. See the Running section of the README.
